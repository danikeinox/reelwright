{
  "name": "reelwright",
  "version": "0.2.0",
  "description": "Local-first, open-source MCP server that turns your website into Instagram Reels: renders on your machine, publishes only after you approve.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "instagram",
    "reels",
    "remotion",
    "claude",
    "video",
    "automation",
    "local-first",
    "open-source"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "reelwright": "dist/cli.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "bundle",
    "docs",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "llms.txt"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && node scripts/copy-ui.mjs && tsc -p tsconfig.remotion.json && node scripts/bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.remotion.json",
    "test": "npm run build && tsc -p tsconfig.test.json && node scripts/copy-ui.mjs dist-test/src/ui && node --test \"dist-test/test/*.test.js\"",
    "prepack": "npm run build",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@aws-sdk/s3-request-presigner": "^3.1150.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@remotion/bundler": "4.0.535",
    "@remotion/renderer": "4.0.535",
    "cheerio": "^1.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "4.0.535",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danikeinox/reelwright.git"
  },
  "homepage": "https://github.com/danikeinox/reelwright#readme",
  "bugs": {
    "url": "https://github.com/danikeinox/reelwright/issues"
  },
  "author": "danikeinox"
}
